# Copy to .env for a run by hand. In Kubernetes: a ConfigMap and a SealedSecret (envFrom).
GA_PROPERTY_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=
LOG_LEVEL=info
# A run by hand: the full report for this day, the preliminary line for the next one.
DIGEST_DATE=

# Secrets, never committed. The whole JSON key of the service account, on one line.
GA_SERVICE_ACCOUNT_JSON=
TELEGRAM_BOT_TOKEN=
